{
  "name": "project-loop-design-system-verification",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:design-system": "ngc -p tsconfig.design-system.json",
    "test:design-system": "ng test design-system --watch=false",
    "test:unit": "npm run test:design-system",
    "test:documentation": "node src/web/design-system/documentation/check-documentation-coverage.mjs && node src/web/design-system/documentation/check-component-documentation.mjs",
    "test:responsive": "node src/web/design-system/documentation/check-responsive-documentation.mjs",
    "test:integration-manifest": "node src/web/design-system/testing/check-integration-manifest.mjs",
    "test:boundaries": "node src/web/design-system/testing/check-feature-boundaries.mjs --self-test && node src/web/design-system/testing/check-feature-boundaries.mjs && node src/web/design-system/testing/check-design-system-boundaries.mjs --self-test && node src/web/design-system/testing/check-design-system-boundaries.mjs",
    "test:visual": "playwright test visual-regression/tests/design-system.visual.spec.ts",
    "test:visual:update": "playwright test visual-regression/tests/design-system.visual.spec.ts --update-snapshots",
    "test:accessibility": "playwright test visual-regression/tests/design-system.accessibility.spec.ts",
    "test:feature-boundaries": "node src/web/design-system/testing/check-feature-boundaries.mjs --self-test && node src/web/design-system/testing/check-feature-boundaries.mjs"
  },
  "dependencies": {
    "@angular/common": "22.1.2",
    "@angular/core": "22.1.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@angular/build": "22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler": "22.1.2",
    "@angular/compiler-cli": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.1.14",
    "jsdom": "30.0.1",
    "tailwindcss": "4.1.14",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
